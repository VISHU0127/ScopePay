# Copy to .env.local; never commit actual values.
# No credentials needed for a private demo. Start it explicitly from /signin.
# Demo is temporary, browser-session isolated, single-process, and simulated only.

# Persistent workspace: apply BOTH supabase/migrations in filename order.
# Create an email/password account in Supabase Auth before signing in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local-only override; only the literal true enables it.
FORCE_DEMO_STORE=false

# Optional live AI. Without it, the exact sample uses fixtures;
# other agreements receive conservative manual-review guidance.
GEMINI_API_KEY=
# Select a model available to your API key.
GEMINI_MODEL=gemini-3.5-flash

# Genuine PayPal sandbox requires persistent Supabase storage and all four values.
# Merchant ID is the sandbox BUSINESS account's merchant ID, not client ID/email.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Canonical browser origin used for origin checks and PayPal return/cancel URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
